# ── Supabase (Postgres + service-role key; NOT Supabase Auth) ─────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── ioTec Pay — Mobile Money Uganda (MTN + Airtel) ───────────────
# Dashboard: https://pay.iotec.io   ·   demo test number: 0111777777
IOTEC_BASE_URL=https://pay.iotec.io
IOTEC_AUTH_URL=https://id.iotec.io/connect/token   # OAuth2 client_credentials token endpoint
IOTEC_CLIENT_ID=your_client_id            # empty or "demo" = demo mode, no real charges
IOTEC_CLIENT_SECRET=your_client_secret
IOTEC_WALLET_ID=your_wallet_id
IOTEC_WEBHOOK_SECRET=your_webhook_secret  # verifies POST /api/webhooks/iotec

# ── Platform ─────────────────────────────────────────────────────
PLATFORM_COMMISSION=0.10                   # 10% platform cut, tipster gets 90%
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (phone identity, signed-cookie sessions) ────────────────
# Tipsters/admins log in with phone + password; buyers are identified by the
# phone they pay with (no login). Sessions are signed HMAC cookies.
SESSION_SECRET=                            # optional; falls back to SUPABASE_SERVICE_ROLE_KEY

# ── Admin panel ──────────────────────────────────────────────────
# Admin logs in with this single master password (sets a secure session cookie).
ADMIN_PASSWORD=change_me

# ── Claude Vision — betslip screenshot parsing ───────────────────
ANTHROPIC_API_KEY=your_anthropic_key

# ── api-football — auto-verify match results (free tier: 100/day) ─
# https://dashboard.api-football.com
FOOTBALL_API_KEY=your_api_football_key

# ── Bet-code worker (separate Docker service — see /bet-code-worker) ─
# Loads a booking code on a bookie and scrapes the selected matches.
BET_CODE_WORKER_URL=http://localhost:8080   # docker-compose overrides → http://bet-code-worker:8080
BET_CODE_WORKER_KEY=change_me_long_random   # must match the worker's WORKER_API_KEY

# Auto-sync poller (docker-compose `sync` service → /api/slips/sync-codes)
SYNC_TOKEN=change_me_long_random            # protects the sync endpoint
SYNC_INTERVAL=300                           # seconds between auto-verify polls
SYNC_BATCH=20                               # max coded slips re-verified per poll

# Gemini (bet-code-worker response normalisation) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Bookie code-sync. Set to false in PRODUCTION (scraper is blocked from
# datacenter IPs) and run the code-sync from a local stack instead. Default: true.
SYNC_CODES_ENABLED=true
