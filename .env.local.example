# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Flutterwave ───────────────────────────────────────────────────
# Get these from: https://dashboard.flutterwave.com/dashboard/settings/apis
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X       # starts with FLWPUBK_TEST
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X       # starts with FLWSECK_TEST
FLW_ENCRYPT_KEY=xxxxxxxxxxxxxxxxx                         # 3DES encryption key
FLW_WEBHOOK_SECRET=your_webhook_secret                    # set this in FLW dashboard too

# ── Platform ─────────────────────────────────────────────────────
PLATFORM_COMMISSION=0.10
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin panel ───────────────────────────────────────────────────
ADMIN_PASSWORD=Betfluencer@Admin2026

# Football API — auto-verification of match results
# Sign up free at: https://dashboard.api-football.com
# Free tier: 100 requests/day
FOOTBALL_API_KEY=your_api_football_key_here
