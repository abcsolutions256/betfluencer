# Shared secret — the Next app must send this as the `x-worker-key` header.
WORKER_API_KEY=change_me_long_random

# Port the API listens on.
PORT=8080

# Max concurrent headless-Chrome scrapes (each one is heavy).
MAX_CONCURRENT=2

# Per-scrape navigation timeout (ms).
NAV_TIMEOUT_MS=45000

# Debug screenshots (taken before each page closes, served at /shots).
SCREENSHOT_DIR=./screenshots
SCREENSHOT_TTL_HOURS=48
# Absolute base URL for returned screenshot links (set behind a TLS proxy,
# e.g. https://worker.yourdomain.com). Defaults to the request host.
# PUBLIC_BASE_URL=

# Chromium binary (set by the Dockerfile; only override for local dev).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
